# Mercado Pago (Fase 10.3 — infraestrutura server-side; checkout/webhook
# ainda não implementados). Use as credenciais de TESTE/sandbox do painel
# do Mercado Pago aqui, nunca as de produção, até a integração real estar
# pronta. Nunca prefixar com NEXT_PUBLIC_ — nenhuma dessas variáveis pode
# chegar ao navegador nesta fase.
MERCADO_PAGO_ACCESS_TOKEN=your-mercado-pago-access-token
MERCADO_PAGO_PUBLIC_KEY=your-mercado-pago-public-key
# Reservada para a validação de assinatura do webhook (Fase 10.4+); não é
# usada nem validada ainda nesta fase.
MERCADO_PAGO_WEBHOOK_SECRET=your-mercado-pago-webhook-secret
